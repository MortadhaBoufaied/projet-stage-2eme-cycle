    with c2:
        st.markdown('<div style="font-weight:700;color:var(--warning);font-size:0.88rem;margin:0.6rem 0 0.35rem;">⚠ Cautions & Edge Cases</div>',unsafe_allow_html=True)
        for x in ass.get('weaknesses',[]):
